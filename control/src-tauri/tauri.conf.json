{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ExVRAM Control",
  "version": "0.1.0",
  "identifier": "lab.exvram.control",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ExVRAM Control",
        "width": 440,
        "height": 780,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
